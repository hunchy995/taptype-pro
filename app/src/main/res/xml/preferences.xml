<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="Appearance">

        <com.taptype.taptypepro.ui.OrbSizePreference
            app:key="orb_size"
            app:title="@string/orb_size"
            app:summary="@string/orb_size_summary"
            app:defaultValue="56" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Dictation">

        <SwitchPreferenceCompat
            app:key="auto_stop"
            app:title="@string/auto_stop"
            app:summary="@string/auto_stop_summary"
            app:defaultValue="false" />

        <SwitchPreferenceCompat
            app:key="auto_capitalize"
            app:title="@string/auto_capitalize"
            app:summary="@string/auto_capitalize_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="auto_punctuation"
            app:title="@string/auto_punctuation"
            app:summary="@string/auto_punctuation_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="smart_punctuation"
            app:title="@string/smart_punctuation"
            app:summary="@string/smart_punctuation_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="auto_numbers"
            app:title="@string/auto_numbers"
            app:summary="@string/auto_numbers_summary"
            app:defaultValue="true" />

        <Preference
            app:key="filter_words"
            app:title="@string/filter_words"
            app:summary="@string/filter_words_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Feedback">

        <SwitchPreferenceCompat
            app:key="haptics"
            app:title="@string/haptics"
            app:summary="@string/haptics_summary"
            app:defaultValue="true" />

    </PreferenceCategory>

        <PreferenceCategory app:title="Privacy / Security">

        <Preference
            app:key="blocked_apps"
            app:title="@string/blocked_apps_title"
            app:summary="@string/blocked_apps_summary" />

    </PreferenceCategory>

</PreferenceScreen>
