<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/orb_size"
    android:layout_height="@dimen/orb_size">

    <!-- Recording pulse ring -->
    <View
        android:id="@+id/recordingRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/orb_ring"
        android:visibility="gone" />

    <!-- Main orb -->
    <ImageView
        android:id="@+id/orbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="10dp"
        android:src="@drawable/ic_mic"
        android:background="@drawable/orb_background"
        android:contentDescription="@string/tap_to_record" />

</FrameLayout>
